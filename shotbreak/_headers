/*
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  # SECURITY NOTE — script-src 'unsafe-inline' is RETAINED here as a known
  # residual XSS risk. app.html and workflow/index.html contain inline boot
  # <script> blocks that would fail to execute without it. Mitigation requires
  # a separate refactor task: extract those inline scripts to external files
  # (or add per-request nonces via an edge function) and then drop
  # 'unsafe-inline'. 'strict-dynamic' is NOT used here because we have no
  # nonce/hash source — adding it without nonces would break script loading.
  # Until the refactor lands, never inject untrusted/agent-generated text into
  # innerHTML — use textContent or DOM APIs instead.
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval' https://www.gstatic.com https://apis.google.com https://accounts.google.com https://cdnjs.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; connect-src 'self' https://*.googleapis.com https://*.firebaseio.com https://firestore.googleapis.com https://identitytoolkit.googleapis.com https://securetoken.googleapis.com https://api.anthropic.com https://wavespeed.ai https://*.wavespeed.ai https://fal.run https://*.fal.run https://api.stripe.com; img-src 'self' data: blob: https://cdn.wavespeed.ai https://*.fal.media; media-src 'self' blob: https://cdn.wavespeed.ai https://*.fal.media; worker-src 'self' blob: https://cdnjs.cloudflare.com; frame-ancestors 'self';

# ═══════════════════════════════════════════════════════════════════════
# CACHE BUSTING — prevents stale JS/HTML after every deploy.
# JS, CSS, and HTML must revalidate on every load. Without these rules,
# browsers cache app.html and workflow.js for the default TTL (often days)
# and users see old behavior for hours/days after a Netlify deploy.
# ═══════════════════════════════════════════════════════════════════════
/*.js
  Cache-Control: no-cache, no-store, must-revalidate

/*.html
  Cache-Control: no-cache, no-store, must-revalidate

/*.css
  Cache-Control: no-cache, no-store, must-revalidate

/workflow/*
  Cache-Control: no-cache, no-store, must-revalidate

/agents/*
  Cache-Control: no-cache, no-store, must-revalidate

# FFmpeg.wasm needs these headers for SharedArrayBuffer threading on /app.html.
/app.html
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: credentialless

# Editor page also uses ffmpeg.wasm for client-side rendering of the timeline.
/editor/*
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: credentialless

# Workflow shell — shares auth/fetch behavior with app.html.
/workflow/*
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: credentialless

# Self-hosted FFmpeg files — pin Content-Type explicitly so X-Content-Type-
# Options: nosniff (set globally above) can't reject importScripts(), and use
# CORP cross-origin so blob workers (which appear cross-origin to CORP checks
# in some Chromium versions) can load them.
/static/ffmpeg/*.js
  Content-Type: application/javascript; charset=utf-8
  Cross-Origin-Resource-Policy: cross-origin
  Cache-Control: public, max-age=31536000, immutable

/static/ffmpeg/*.wasm
  Content-Type: application/wasm
  Cross-Origin-Resource-Policy: cross-origin
  Cache-Control: public, max-age=31536000, immutable

/static/ffmpeg/*
  Cross-Origin-Resource-Policy: cross-origin
  Cache-Control: public, max-age=31536000, immutable

/index.html
  Cache-Control: public, max-age=3600

/*.png
  Cache-Control: public, max-age=31536000

/*.ico
  Cache-Control: public, max-age=31536000
