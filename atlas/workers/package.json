{
  "name": "atlas-workers",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "migrate:local": "wrangler d1 migrations apply atlas --local",
    "migrate:prod": "wrangler d1 migrations apply atlas --remote",
    "seed:local": "wrangler d1 execute atlas --local --file=./migrations/0002_seed_universe.sql",
    "seed:prod": "wrangler d1 execute atlas --remote --file=./migrations/0002_seed_universe.sql",
    "tail": "wrangler tail",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.40.0",
    "stripe": "^17.5.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250101.0",
    "typescript": "^5.7.0",
    "wrangler": "^3.99.0"
  }
}
